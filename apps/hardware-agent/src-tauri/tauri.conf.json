{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "838 Hardware Agent",
  "version": "1.0.0",
  "identifier": "app.838.hardware-agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "838 Hardware Agent",
        "width": 760,
        "height": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
