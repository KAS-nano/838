*.tsbuildinfo
next-env.d.ts.bak

# Prisma
/src/generated/prisma/
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite
/prisma/*.sqlite-journal
/prisma/*.db-wal
/prisma/*.db-shm
/prisma/*.sqlite-wal
/prisma/*.sqlite-shm

# Backups locais (o script oficial exige destino fora do repositório)
/backups/
*.dump
*.dump.age
*.dump.age.sha256

# Rust e Tauri
/apps/hardware-agent/src-tauri/target/
/apps/hardware-agent/src-tauri/gen/schemas/
**/*.rs.bk

# Variáveis locais e segredos
.env*
!/.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# Logs e diagnósticos de gerenciadores
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sistema operacional e editores
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Arquivos temporários e patches locais
*.tmp
*.temp
*.orig
*.rej

# Metadados gerados somente em releases
/sbom-web.cdx.json
/sbom-rust.cdx.json
/release-provenance.json
/SHA256SUMS

# Pacotes nativos preparados para upload
/native-artifacts/

# Manter versionados: package-lock.json, Cargo.lock, next-env.d.ts,
# prisma/migrations/, preview/, public/, planning/ e reports/.
# Não ignorar *.sql: as migrações Prisma fazem parte do código.
