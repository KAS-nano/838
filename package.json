{
  "name": "838",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:static": "node scripts/static-check.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore:drill": "bash scripts/db-restore-drill.sh",
    "agent:check": "cargo +1.95.0 fmt --manifest-path apps/hardware-agent/src-tauri/Cargo.toml -- --check && cargo +1.95.0 test --locked --manifest-path apps/hardware-agent/src-tauri/Cargo.toml && cargo +1.95.0 clippy --locked --manifest-path apps/hardware-agent/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "auth:generate": "npx auth@latest generate --adapter prisma --dialect postgresql",
    "test:stages": "bash scripts/run-stage-tests.sh",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts",
    "clean:local": "node scripts/clean-local.mjs",
    "clean:local:dry": "node scripts/clean-local.mjs --dry-run",
    "postinstall": "prisma generate",
    "preview:generate": "node scripts/generate-support-qr.mjs && node scripts/export-preview-catalog.mjs",
    "prebuild": "npm run preview:generate",
    "test:engine": "bash scripts/frontend-engine-check.sh",
    "test:support": "node scripts/support-test.mjs && node scripts/generate-support-qr.mjs --check",
    "check": "npm run check:hygiene && npm run check:versions && npm run preview:check && npm run typecheck && npm run lint && npm run test:unit",
    "check:hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:versions": "node scripts/check-version-sync.mjs",
    "preview:check": "node scripts/generate-support-qr.mjs --check && node scripts/export-preview-catalog.mjs --check",
    "test:unit": "npm run test:stages",
    "test:integration": "npx prisma validate",
    "deploy:check": "node scripts/deploy-readiness.mjs && npm run check:hygiene && npm run preview:check && npm run typecheck && npm run lint && npm run test:stages && npm run build",
    "deploy:smoke": "node scripts/deployment-smoke.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "jsqr": "^1.4.0",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
